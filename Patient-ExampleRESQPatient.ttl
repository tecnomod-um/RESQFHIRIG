  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient ExampleRESQPatient</b></p><a name=\"ExampleRESQPatient\"> </a><a name=\"hcExampleRESQPatient\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-resq-patient-profile.html\">RESQ Patient Profile</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Anonymous Patient (no stated gender), DoB Unknown ( patient-001)</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Sex/gender value as a SNOMED CT CodeableConcept, matching build_Patient().\"><a href=\"StructureDefinition-gender-snomed-ext.html\">Gender represented with SNOMED CT</a></td><td colspan=\"3\"><span title=\"Codes:{http://snomed.info/sct 248153007}\">Male (finding)</span></td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:extension ( [
     fhir:url [ fhir:v "http://tecnomod-um.org/StructureDefinition/gender-snomed-ext"^^xsd:anyURI ] ;
     fhir:value [
       a fhir:CodeableConcept ;
       fhir:coding ( [
         a sct:248153007 ;
         fhir:system [ fhir:v "http://snomed.info/sct"^^xsd:anyURI ] ;
         fhir:code [ fhir:v "248153007" ] ;
         fhir:display [ fhir:v "Male (finding)" ]
       ] )
     ]
  ] ) ; # 
  fhir:identifier ( [
     fhir:value [ fhir:v "patient-001" ]
  ] ) . # 

