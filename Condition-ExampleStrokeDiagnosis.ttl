     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Condition ExampleStrokeDiagnosis</b></p><a name=\"ExampleStrokeDiagnosis\"> </a><a name=\"hcExampleStrokeDiagnosis\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-stroke-diagnosis-condition-profile.html\">Stroke Diagnosis Condition Profile</a></p></div><p><b>Wake-up stroke</b>: false</p><p><b>clinicalStatus</b>: <span title=\"Codes:{http://terminology.hl7.org/CodeSystem/condition-clinical active}\">Active</span></p><p><b>verificationStatus</b>: <span title=\"Codes:{http://terminology.hl7.org/CodeSystem/condition-ver-status confirmed}\">Confirmed</span></p><p><b>category</b>: <span title=\"Codes:{http://terminology.hl7.org/CodeSystem/condition-category encounter-diagnosis}\">Encounter Diagnosis</span></p><p><b>code</b>: <span title=\"Codes:{http://snomed.info/sct 422504002}\">Ischemic stroke (disorder)</span></p><p><b>subject</b>: <a href=\"Patient-ExampleRESQPatient.html\">Anonymous Patient (no stated gender), DoB Unknown ( patient-001)</a></p><p><b>encounter</b>: <a href=\"Encounter-ExampleStrokeEncounter.html\">Encounter: extension = -&gt;Organization Example Healthcare Organization,false,true; status = completed</a></p></div>"^^rdf:XMLLiteral ]
