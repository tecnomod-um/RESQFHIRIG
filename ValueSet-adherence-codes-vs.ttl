     fhir:status [ fhir:v "extensions" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet adherence-codes-vs</b></p><a name=\"adherence-codes-vs\"> </a><a name=\"hcadherence-codes-vs\"> </a><ul><li>Include these codes as defined in <a href=\"http://hl7.org/fhir/R5/codesystem-medication-statement-adherence.html\"><code>http://hl7.org/fhir/CodeSystem/medication-statement-adherence</code></a><span title=\"Version is not explicitly stated, which means it is fixed to 5.0.0, the version found through the package references\"> version ?5.0.0</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"http://hl7.org/fhir/R5/codesystem-medication-statement-adherence.html#medication-statement-adherence-taking\">taking</a></td><td>Taking</td><td>The medication is being taken.</td></tr><tr><td><a href=\"http://hl7.org/fhir/R5/codesystem-medication-statement-adherence.html#medication-statement-adherence-not-taking\">not-taking</a></td><td>Not Taking</td><td>The medication is not being taken.</td></tr><tr><td><a href=\"http://hl7.org/fhir/R5/codesystem-medication-statement-adherence.html#medication-statement-adherence-unknown\">unknown</a></td><td>Unknown</td><td>Whether the medication is being taken or not is not currently known.</td></tr></table></li></ul></div>"^^rdf:XMLLiteral ]
