  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2026-08-31T10:08:26+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "Tecnomod / Universidad de Murcia"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "Tecnomod / Universidad de Murcia" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://qualityregistry.org" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Allowed coded values for ClinicalStatusCodes"] ; # 
  fhir:jurisdiction ( [
     fhir:coding ( [
       fhir:system [ fhir:v "urn:iso:std:iso:3166"^^xsd:anyURI ] ;
       fhir:code [ fhir:v "ES" ] ;
       fhir:display [ fhir:v "Spain" ]
     ] )
  ] ) ; # 
  fhir:compose [
     fhir:include ( [
       fhir:system [ fhir:v "http://terminology.hl7.org/CodeSystem/condition-clinical"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "active" ] ;
         fhir:display [ fhir:v "Active" ]
       ] [
         fhir:code [ fhir:v "inactive" ] ;
         fhir:display [ fhir:v "Inactive" ]
       ] [
         fhir:code [ fhir:v "remission" ] ;
         fhir:display [ fhir:v "Remission" ]
       ] [
         fhir:code [ fhir:v "unknown" ] ;
         fhir:display [ fhir:v "Unknown" ]
       ] )
     ] )
